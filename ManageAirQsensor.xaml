<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.ManageWaterQsensor"
             Title="Manage Water Quality Sensor"
             BackgroundColor="Black">
    <VerticalStackLayout Padding="20" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center">

        <!-- Title Text -->
        <Label Text="Text"
               FontSize="24"
               TextColor="White"
               HorizontalOptions="Center" />

        <!-- Sensitivity Section -->
        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Label Text="Sensitivity"
                   FontSize="18"
                   TextColor="White"
                   VerticalOptions="Center" />
            <Picker Title="Dropdown button"
                    WidthRequest="120"
                    BackgroundColor="Gray"
                    TextColor="White" />
            <Picker Title="Dropdown button"
                    WidthRequest="120"
                    BackgroundColor="Gray"
                    TextColor="White" />
        </HorizontalStackLayout>

        <!-- Air Pollutant Sensor Section -->
        <Label Text="pH sensor"
               FontSize="18"
               TextColor="White"
               HorizontalOptions="Center" />

        <!-- Button -->
        <Button Text="Button"
                FontSize="18"
                BackgroundColor="Gray"
                TextColor="White"
                WidthRequest="200"
                HeightRequest="50"
                HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
