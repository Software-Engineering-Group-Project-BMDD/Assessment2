<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.SensorAccountsPage"
             Title="SensorAccountsPage"
             BackgroundColor="Black">
    <Grid>
        <!-- Profile Icon -->
        <Image Source="profile_icon.png"
               HorizontalOptions="End"
               VerticalOptions="Start"
               Margin="10"
               HeightRequest="40"
               WidthRequest="40" />

        <!-- Main Content -->
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- Sensor Items -->
            <HorizontalStackLayout Spacing="10">
                <Image Source="gear_icon.png"
                       HeightRequest="40"
                       WidthRequest="40" />
                <Label Text="Air Quality Sensor"
                       TextColor="White"
                       VerticalOptions="Center" />
                <HorizontalStackLayout Spacing="5" HorizontalOptions="EndAndExpand">
                    <Image Source="cloud_icon.png"
                           HeightRequest="30"
                           WidthRequest="30" />
                    <Image Source="signal_icon.png"
                           HeightRequest="30"
                           WidthRequest="30" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Image Source="gear_icon.png"
                       HeightRequest="40"
                       WidthRequest="40" />
                <Label Text="Water Quality Sensor"
                       TextColor="White"
                       VerticalOptions="Center" />
                <HorizontalStackLayout Spacing="5" HorizontalOptions="EndAndExpand">
                    <Image Source="cloud_icon.png"
                           HeightRequest="30"
                           WidthRequest="30" />
                    <Image Source="signal_icon.png"
                           HeightRequest="30"
                           WidthRequest="30" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Image Source="gear_icon.png"
                       HeightRequest="40"
                       WidthRequest="40" />
                <Label Text="Weather Sensor"
                       TextColor="White"
                       VerticalOptions="Center" />
                <HorizontalStackLayout Spacing="5" HorizontalOptions="EndAndExpand">
                    <Image Source="cloud_icon.png"
                           HeightRequest="30"
                           WidthRequest="30" />
                    <Image Source="signal_icon.png"
                           HeightRequest="30"
                           WidthRequest="30" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>

            <!-- Button -->
            <Button Text="Firmware updates check"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    BorderColor="White"
                    BorderWidth="2"
                    CornerRadius="5"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
