<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.ActivityPage"
             Title="Activity Page">
    <VerticalStackLayout Padding="30,0" Spacing="25">
        <!-- Navigation Buttons -->
        <Button Text="Water Quality" Command="{Binding NavigateCommand}" CommandParameter="WaterQualityPage" />
        <Button Text="Air Quality" Command="{Binding NavigateCommand}" CommandParameter="AirQualityPage" />
        <Button Text="Meteorological Data" Command="{Binding NavigateCommand}" CommandParameter="MeteorologicalPage" />
    </VerticalStackLayout>
</ContentPage>
