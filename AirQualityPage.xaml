<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.ManageWaterQsensor"
             Title="ManageWaterQsensor">
    <CollectionView x:Name="AirQualityTb" ItemsSource="{Binding AirQualityItems}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="Auto,1,Auto,1,Auto,1,Auto,1,Auto">
                    <Label Text="{Binding Date}" Grid.Column="0" />
                    <BoxView BackgroundColor="Gray" Grid.Column="1" WidthRequest="1" />
                    <Label Text="{Binding Time}" Grid.Column="2" />
                    <BoxView BackgroundColor="Gray" Grid.Column="3" WidthRequest="1" />
                    <Label Text="{Binding PM25}" Grid.Column="4" />
                    <BoxView BackgroundColor="Gray" Grid.Column="5" WidthRequest="1" />
                    <Label Text="{Binding PM10}" Grid.Column="6" />
                    <BoxView BackgroundColor="Gray" Grid.Column="7" WidthRequest="1" />
                    <Label Text="{Binding CO}" Grid.Column="8" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>